App = use "../src/inventory".
Digest = use "std/digest".
List = use "std/list".
Option = use "std/option".
check why yes = if yes then print "PASS {why}" else error why.
main =
  _ = check "canonical tags" (App.tagsOf "USB, cables ,usb" == ["usb","cables"]);
  _ = check "member names" (App.wordy "user123" and not (App.wordy "Bad Name"));
  initial = App.project 10 10 1 App.initModel;
  _ = check "new visit waits for client state" (not initial.clientReady and initial.signed == 0);
  (guest, _) = App.mirror App.initModel 1 App.client;
  guestView = App.project 10 10 1 guest;
  _ = check "guest sees login after sync" (guestView.clientReady and guestView.signed == 0);
  known = { App.initModel | devices = [(Digest.sha256 "fixture", "member")] };
  (restored, _) = App.mirror known 1 { App.client | tok = "fixture" };
  restoredView = App.project 10 10 1 restored;
  _ = check "remembered visit opens inventory on first sync" (restoredView.signed == 1 and restoredView.user == "member");
  (expired, _) = App.mirror App.initModel 1 { App.client | tok = "expired" };
  expiredView = App.project 10 10 1 expired;
  _ = check "unrecognized device gets login" (expiredView.clientReady and expiredView.signed == 0);
  item = {id=1,name="FP-RISC board",loc="Office",sub="Shelf",desc="test",tags=["electronics"],created=100,at=100,by="test",moves=Nil};
  first = App.apply App.initModel (App.itemLine item "test" 100);
  _ = check "journal creates item" (List.length first.items == 1 and first.nextId == 2);
  moved = App.apply first (App.itemLine {item | loc="Workshop"} "test" 200);
  found = case App.findItem moved.items 1 of Option.Some x -> x | _ -> error "item missing";
  _ = check "moves retain creation and prior location" (found.created == 100 and List.length found.moves == 1);
  gone = App.apply moved (App.delLine 1 "test" 300);
  _ = check "delete replay" (List.length gone.items == 0);
  bad = App.apply gone "not JSON";
  _ = check "bad journal line counted" (bad.skipped == 1);
  journal = [App.itemLine item "test" 100, App.itemLine {item | loc="Workshop"} "test" 200,
             App.itemLine {item | id=2, name="Scope"} "test" 210, App.renameLine {item | loc="Lab"} "test" 220,
             App.delLine 1 "test" 300, App.itemLine item "test" 400, "not JSON", App.delLine 9 "test" 500];
  booted = App.replayed App.initModel journal;
  applied = List.fold (fn mm l -> App.apply mm l) App.initModel journal;
  _ = check "boot replay matches the live apply" (booted.items == applied.items and booted.nextId == applied.nextId and booted.skipped == 1 and booted.events == 8);
  fresh = App.notHere moved.items [{item | name="fp-risc BOARD", loc="workshop"}, {item | name="FP-RISC board"}, {item | name="Other"}];
  _ = check "import skips names already in the same place" (List.map (fn it -> it.name) fresh == ["FP-RISC board","Other"]);
  _ = check "suggestions keep the first spelling" (App.uniqueCi ["Office","office","","Lab","OFFICE","lab"] == ["Office","Lab"]);
  print "inventory checks passed".
