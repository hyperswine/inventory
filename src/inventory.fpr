# ============================================================================
# inventory.fpr -- where everything in the house is.  A household inventory in
# FP-RISC Base on the posix system, served by std/live, shaped like pos1.fpr:
# phones and laptops are websocket sessions over ONE model actor, and the disk
# holds ONE append-only log, which is the inventory.
#
#   sol project.sol run [--port=6720] [--address=127.0.0.1] [--store=data/inventory.log]
#                                  [--page-size=20] [--cache-items=200]
#   sol project.sol run --member=NAME --password=SECRET      (add a member, then exit)
#   sol project.sol run --import=firestore.json             (the old app's items, then exit)
#
# Every setting is also INV_<NAME> in the environment (INV_PASSWORD keeps a
# password out of the shell history).
#
# THE ONE RULE (pos1's).  Every change is a LINE, and `apply` is the only thing
# that reads a line into the model.  A handler validates, then `commit`s the
# line: apply it now and queue it for the disk.  Boot is the same `apply`
# folded over the log, so what a phone shows is what a restart would rebuild.
# A line is one JSON object, because names and notes are free text:
#
#   {"op":"item","id":7,"name":..,"loc":..,"sub":..,"desc":..,"tags":[..],"by":..,"at":..[,"created":..]}
#   {"op":"del","id":7,"by":..,"at":..}
#   {"op":"member","name":..,"salt":..,"hash":..,"at":..}     a password, salted and hashed
#   {"op":"device","name":..,"hash":..,"at":..}               a remembered phone (the token's hash)
#   {"op":"undevice","hash":..,"at":..}   {"op":"revoke","name":..,"at":..}
#
# An edit is a new "item" line with the same id, so the log is every item's
# history: the model keeps the last few places an item was moved from.
#
# PAGES.  A tab shows `page-size` items at a time.  Its writer remembers the
# rendered cards of the pages it showed lately, up to `cache-items` of them
# (std/view `cacheRetain`): going back a page is free, and a tab that has
# looked at every page still holds at most that many cards -- past that, a card
# is rendered again from the model.
#
# AUTOCOMPLETE.  When the editor opens, the server hands the page the household's
# rooms, spots (per room) and tags, the ones edited lately first and your own
# edits before others'.  The page's script suggests from them as you type:
# Tab (or Enter after choosing with the arrow keys) takes a suggestion, and on a
# phone tapping the field you are already in takes the first one.
#
# THE ADMIN PANE (pos1's).  A profile of the app measuring itself -- each kind
# of event's update, the disk append, the boot fold, this tab's renders and
# its card cache, the runtime's memory, the browser's round trip -- projected
# only to a tab looking at it.  And a console over the data: `help` lists the
# commands; the ones that change things commit lines like any other edit.
#
# SIGNING IN.  A member signs in once per device with a name and password; the
# server then hands the page a random token, which the page keeps in
# localStorage and mirrors back on every connection.  Only its hash is in the
# log.  Signing out forgets that device; "sign out other devices" forgets the rest.
# ============================================================================

B = use "std/browser".

profile base.

Live = use "std/live".
G = use "std/view".
UI = use "std/ui".
Appearance = use "std/appearance".
LJ = use "std/livejs".
List = use "std/list".
Pagination = use "std/pagination".
S = use "std/string".
File = use "std/file".
Stream = use "std/stream".
Journal = use "std/journal".
Clock = use "std/clock".
Config = use "std/config".
Decode = use "std/decode".
Json = use "std/json".
Program = use "std/program".
Option = use "std/option".
Result = use "std/result".
Order = use "std/order".
Digest = use "std/digest".
MutMap = use "std/mutmap".

# The fields the page fills when a button is pressed are the LAST ones
# (G.sendWith): `Login` its name and password, `AddMember` theirs.
Msg = Type (Login String String | Logout | ClientState Client | New | Edit Int | Save | Cancel | Delete Int
          | AddTag String | AddMember String String | Password String | ForgetDevices | Theme | Dismiss | Clear Int Int | Page Int
          | Command String).
codec = @Msg.

# What the page holds.  The search, the sort and the editor's drafts are
# mirrored to the server (Live.SyncClientState), so a Save reads the draft the
# person saw; password inputs never are -- they travel only as a sign-in's or
# a member form's argument.  `tok` is the remembered device, put there by the
# page's script from localStorage.
# `confirm` is the item whose delete is being confirmed (0: none).
Pane = Type (Items | House | Admin).
Sort = Type (Recent | ByName | ByPlace).
Client = { pane : Pane, q : String, sort : Sort, confirm : Int,
           name : String, loc : String, sub : String, desc : String, tags : String,
           user : String, pw : String, tok : String, mname : String, mpw : String, npw : String, cmd : String }.
client = { pane = Items, q = "", sort = Recent, confirm = 0, name = "", loc = "", sub = "", desc = "", tags = "",
           user = "", pw = "", tok = "", mname = "", mpw = "", npw = "", cmd = "" }.

Move = { at : Int, from : String }.
Item = { id : Int, name : String, loc : String, sub : String, desc : String, tags : List String,
         created : Int, at : Int, by : String, moves : List Move }.

# ---- the model --------------------------------------------------------------------
# members are (name, salt, hash); devices are (token hash, name)

initModel = { items = Nil, nextId = 1, members = Nil, devices = Nil, pend = Nil, events = 0, skipped = 0,
              fails = Nil, sess = Nil, booted = 0, path = "", prof = noProf }.
noDraft = { name = "", loc = "", sub = "", desc = "", tags = "" }.
noSess = { sid = 0, clientReady = False, user = "", toast = "", role = "", tn = 0, editing = 0 - 1, q = "", sort = Recent, page = 0, pane = Items, con = Nil,
           tried = "", theme = 1, d = noDraft }.

# the tags offered while editing, before the household has its own
quickTags = ["electronics", "cables", "tools", "kitchen", "bathroom", "office", "bedroom", "storage",
             "cleaning", "books", "clothes", "charging", "computer", "gaming", "furniture", "documents"].

# ---- little prelude -----------------------------------------------------------------

num s = numGo s 0 (strlen s) 0.
numGo : String -> (i : Int | measure (n - i)) -> (n : Int) -> Int -> Int .
numGo s i n acc | i >= n = acc.
numGo s i n acc | S.isDigit (charAt s i) = numGo s (i + 1) n (acc * 10 + charAt s i - 48).
numGo _ _ _ acc = acc.

# a member's name: lower-case letters and digits, 1..16 of them
wordy s = strlen s >= 1 and strlen s <= 16 and wdGo s 0 (strlen s).
wdGo : String -> (i : Int | measure (n - i)) -> (n : Int) -> Bool .
wdGo s i n | i >= n = True.
wdGo s i n =
  c = charAt s i;
  ((c >= 48 and c <= 57) or (c >= 97 and c <= 122)) and wdGo s (i + 1) n.

place it | strlen it.sub == 0 = it.loc.
place it = "{it.loc} / {it.sub}".

# "USB, cables ,usb" -> ["usb", "cables"]
tagsOf raw =
  raw
  |> S.split ","
  |> List.map (fn t -> t |> S.trim |> S.toLower |> S.left 32)
  |> List.filter (fn t -> strlen t > 0)
  |> List.unique.

memName (n, _, _) = n.
memSalt (_, salt, _) = salt.
memHash (_, _, hash) = hash.
devHash (h, _) = h.
devName (_, n) = n.

# ---- reading a line ----------------------------------------------------------------

txt k v = Json.field k v |> Option.andThen Json.asString |> Option.withDefault "".
int k v = Json.field k v |> Option.andThen Json.asInt |> Option.withDefault 0.
strs k v =
  Json.field k v
  |> Option.andThen Json.asList
  |> Option.map (List.filterMap Json.asString)
  |> Option.withDefault Nil.

# ---- the interpreter: one line into the model --------------------------------------
# the whole meaning of the log, live and at boot alike

# A line, read ONCE into what it says (parseLine); `apply`, the boot replay and
# the item history match on that, never on the "op" string.  The disk format is
# the JSON above, unchanged.  An "item" line with "why":"rename" is a Rename (a
# place renamed is the same place: not a move).  A blank line is Blank, a line
# that is not JSON is Unreadable (counted in `skipped`), and JSON with an op
# this version does not know is OtherOp (ignored); each is what it was before.
Op = Type (Put Item | Rename Item | Del Int String Int | Member String String String | Device String String
         | Undevice String | Revoke String | OtherOp | Unreadable | Blank).

parseLine line | strlen (S.trim line) == 0 = Blank.
parseLine line = case Json.parse line of
    Err _ -> Unreadable
  | Ok v -> opOf (txt "op" v) v.

opOf "item" v | txt "why" v == "rename" = Rename (itemOf v).
opOf "item" v     = Put (itemOf v).
opOf "del" v      = Del (int "id" v) (txt "by" v) (int "at" v).
opOf "member" v   = Member (txt "name" v) (txt "salt" v) (txt "hash" v).
opOf "device" v   = Device (txt "name" v) (txt "hash" v).
opOf "undevice" v = Undevice (txt "hash" v).
opOf "revoke" v   = Revoke (txt "name" v).
opOf _ _          = OtherOp.

apply m line = applyOp m (parseLine line).

applyOp m (Put it) = putItem False m it.
applyOp m (Rename it) = putItem True m it.
applyOp m (Del id _ _) = { m | items = dropById m.items id }.
applyOp m (Member name salt hash) =
  { m | members = (name, salt, hash) :: List.filter (fn mm -> memName mm != name) m.members }.
applyOp m (Device name hash) = { m | devices = (hash, name) :: m.devices }.
applyOp m (Undevice hash) = { m | devices = List.filter (fn d -> devHash d != hash) m.devices }.
applyOp m (Revoke name) = { m | devices = List.filter (fn d -> devName d != name) m.devices }.
applyOp m Unreadable = { m | skipped = m.skipped + 1 }.
applyOp m _ = m.

# An "item" line's item; and what it makes of the item already under its id
# (the first creation date stays, a move is remembered).  The live `apply` and
# the boot replay below both go through these two.
itemOf v =
  at = int "at" v;
  made = int "created" v;
  { id = int "id" v, name = txt "name" v, loc = txt "loc" v, sub = txt "sub" v, desc = txt "desc" v,
    tags = strs "tags" v, created = if made == 0 then at else made, at = at, by = txt "by" v, moves = Nil }.

merged renamed old it =
  { it | created = old.created, moves = if renamed then old.moves else movedFrom old it }.

findItem items id = List.find (fn x -> x.id == id) items.

putItem renamed m it =
  next = Int.max m.nextId (it.id + 1);
  case findItem m.items it.id of
      Option.None -> { m | items = it :: m.items, nextId = next }
    | Option.Some old -> { m | items = replaceById m.items it.id (merged renamed old it), nextId = next }.

# Ids are unique in the list, so both stop at the one item and share the rest.
replaceById : (xs : List Item | measure xs) -> Int -> Item -> List Item .
replaceById xs id new = case xs of
    Nil -> Nil
  | x :: r -> if x.id == id then new :: r else x :: replaceById r id new.

dropById : (xs : List Item | measure xs) -> Int -> List Item .
dropById xs id = case xs of
    Nil -> Nil
  | x :: r -> if x.id == id then r else x :: dropById r id.

movedFrom old it | place old == place it = old.moves.
movedFrom old it = List.take 3 ({ at = it.at, from = place old } :: old.moves).

# a validated change: applied now, queued for the disk
commit m line = apply { m | pend = line :: m.pend, events = m.events + 1 } line.

itemFields it by at =
  [("id", Json.Integer it.id), ("name", Json.Text it.name), ("loc", Json.Text it.loc),
   ("sub", Json.Text it.sub), ("desc", Json.Text it.desc), ("tags", Json.strings it.tags),
   ("by", Json.Text by), ("at", Json.Integer at), ("created", Json.Integer it.created)].

itemLine it by at = Json.render (Json.object (("op", Json.Text "item") :: itemFields it by at)).
# the same, marked as a rename of the place it is in
renameLine it by at = Json.render (Json.object (("op", Json.Text "item") :: ("why", Json.Text "rename") :: itemFields it by at)).
delLine id by at = Json.render (Json.object [("op", Json.Text "del"), ("id", Json.Integer id), ("by", Json.Text by), ("at", Json.Integer at)]).
memberLine name salt hash at = Json.render (Json.object
  [("op", Json.Text "member"), ("name", Json.Text name), ("salt", Json.Text salt), ("hash", Json.Text hash), ("at", Json.Integer at)]).
deviceLine name hash at = Json.render (Json.object [("op", Json.Text "device"), ("name", Json.Text name), ("hash", Json.Text hash), ("at", Json.Integer at)]).
undeviceLine hash at = Json.render (Json.object [("op", Json.Text "undevice"), ("hash", Json.Text hash), ("at", Json.Integer at)]).
revokeLine name at = Json.render (Json.object [("op", Json.Text "revoke"), ("name", Json.Text name), ("at", Json.Integer at)]).

# ---- secrets -------------------------------------------------------------------------------
# 32 bytes of the kernel's randomness, as 64 hex digits
randomHex _ = case File.open "/dev/urandom" "r" of
    Err why -> error "inventory: no randomness: {why}"
  | Ok st -> case Stream.read 32 st of
      Ok bytes -> _ = Stream.close st; Digest.sha256 bytes
    | Err why -> _ = Stream.close st; error "inventory: no randomness: {why}".

# a password is stored as sha256 iterated over salt and password: slow enough to
# make a stolen log a chore, quick enough for a sign-in
pwHash salt pw = stretch 200 (Digest.sha256 "{salt}:{pw}") salt.
stretch : (n : Int | measure n) -> String -> String -> String .
stretch n h salt | n <= 0 = h.
stretch n h salt = stretch (n - 1) (Digest.sha256 "{salt}{h}") salt.

checkPw members name pw = case List.find (fn mm -> memName mm == name) members of
    Option.Some mm -> pwHash (memSalt mm) pw == memHash mm
  | Option.None -> _ = pwHash "x" pw; False.   # the same work for a name that does not exist

hasMember m name = List.any (fn mm -> memName mm == name) m.members.
deviceUser devices h = devices |> List.find (fn d -> devHash d == h) |> Option.map devName.

# ---- the disk ----------------------------------------------------------------------------

# The log is an event JOURNAL (std/journal): opened once, a torn last line cut,
# its lines folded into the model.  The journal's owner keeps the file open;
# the model holds the path and the lines it has yet to write, never a handle.
openLog path = case Journal.open path of
    Ok o -> o
  | Err why -> Program.fail 1 "inventory: {why}".

boot o path =
  m0 = { initModel | booted = Clock.now Unit };
  t0 = Sys.timeUs Unit;
  _ = if o.cut > 0 then Sys.stderr "[inventory] cut a torn last line ({o.cut} bytes) off {path}\n" else Unit;
  m2 = replayed m0 o.lines;
  t1 = Sys.timeUs Unit;
  _ = print "[inventory] log {path}: {m2.events} lines in {t1 - t0} us, {List.length m2.items} items, {List.length m2.members} members, {List.length m2.devices} devices";
  _ = if m2.skipped > 0 then Sys.stderr "[inventory] {m2.skipped} unreadable lines skipped\n" else Unit;
  _ = if List.isEmpty m2.members then Sys.stderr "[inventory] no members yet: add one with --member=NAME and INV_PASSWORD\n" else Unit;
  { m2 | path = path, prof = { noProf | bootUs = t1 - t0, bootLines = m2.events } }.

# Boot folds the log into a model nothing else can see yet, so while it does the
# items live in a linear id -> item table (written in place, std/mutmap) and the
# ids in the order the list keeps them (newest first); the list is built once at
# the end.  Item and delete lines take the same itemOf/merged as `apply`; every
# other line goes through applyOp.  A model that already has items folds as
# before.
replayed m ls = case m.items of
    Nil -> replayOwned m ls
  | _ -> List.fold (fn mm l -> apply { mm | events = mm.events + 1 } l) m ls.

replayOwned m ls =
  (m2, tbl, order) = List.fold replayLine (m, MutMap.ints Unit, Nil) ls;
  (items, tbl2) = List.fold emitId (Nil, tbl) order;
  _ = MutMap.free tbl2;
  { m2 | items = List.reverse items }.

# a deleted id made again sits in the order twice: its newest place wins
emitId (acc, tbl) id = case MutMap.get id tbl of
    (Option.Some it, t1) -> (it :: acc, MutMap.remove id t1)
  | (Option.None, t1) -> (acc, t1).

replayLine (mm, tbl, order) l = replayOp { mm | events = mm.events + 1 } tbl order (parseLine l).
replayOp m tbl order (Put it) = replayPut m tbl order False it.
replayOp m tbl order (Rename it) = replayPut m tbl order True it.
replayOp m tbl order (Del id _ _) = (m, MutMap.remove id tbl, order).
replayOp m tbl order op = (applyOp m op, tbl, order).

replayPut m tbl order renamed it =
  m2 = { m | nextId = Int.max m.nextId (it.id + 1) };
  case MutMap.get it.id tbl of
      (Option.None, t1) -> (m2, MutMap.insert it.id it t1, it.id :: order)
    | (Option.Some old, t1) -> (m2, MutMap.insert it.id (merged renamed old it) t1, order).

# The pending lines, oldest first, in ONE write.  A write that fails, or a
# file that is no longer the one the journal left (a backup restored over it,
# a member added from the command line while the server runs), stops the
# server: the page must never show a change the disk does not have; launchd
# starts it again, and the model is folded from what the file holds now.
flush j m = case m.pend of
    Nil -> m
  | ls -> case Journal.append (List.reverse ls) j of
      Ok _ -> { m | pend = Nil }
    | Err why -> error "inventory: {why}".

# ---- sessions ----------------------------------------------------------------------------

sGet ss sid = ss |> List.find (fn s -> s.sid == sid) |> Option.withDefault { noSess | sid = sid }.
sPut m s = { m | sess = s :: sDel m.sess s.sid }.
sDel ss sid = List.filter (fn s -> s.sid != sid) ss.
forget m sid = { m | sess = sDel m.sess sid }.

# a toast: text with a role (ok, warn); it clears itself after a while unless
# a newer one replaced it
toast m sid role text =
  s = sGet m.sess sid;
  (sPut m { s | toast = text, role = role, tn = s.tn + 1 }, [Live.After 4000 (Clear sid (s.tn + 1))]).
say m sid text = toast m sid "ok" text.
refuse m sid text = toast m sid "warn" text.
also (m, cs) more = (m, List.append cs more).

setLocals sid kvs = Live.setClient sid kvs.
draftLocals d = [G.assign @Client.name d.name, G.assign @Client.loc d.loc, G.assign @Client.sub d.sub, G.assign @Client.desc d.desc, G.assign @Client.tags d.tags].

# ---- update ------------------------------------------------------------------------------

# every event is timed: the app's own work, and the disk append when it wrote
update j ev m =
  t0 = Sys.timeUs Unit;
  (m2, cs) = step ev m;
  t1 = Sys.timeUs Unit;
  wrote = not (List.isEmpty m2.pend);
  m3 = flush j m2;
  t2 = Sys.timeUs Unit;
  prof = noteUpd (kindOf ev) (t1 - t0) m3.prof;
  ({ m3 | prof = if wrote then { prof | flush = note prof.flush (t2 - t1) } else prof }, cs).

step (Live.Msg sid msg) m = pMsg sid msg m.
step (Live.Left sid) m = (forget m sid, Nil).
step (Live.Joined _) m = (m, Nil).
step (Live.Refused sid why) m = refuse m sid "refused: {why}".

pMsg sid (Login name pw) m = login m sid name pw.
pMsg sid (ClientState c) m = mirror m sid c.
pMsg 0 (Clear who n) m = (clearToast m who n, Nil).
pMsg _ (Clear _ _) m = (m, Nil).
pMsg sid Dismiss m = (dismiss m (sGet m.sess sid), Nil).
pMsg sid Theme m = (flipTheme m (sGet m.sess sid), Nil).
pMsg sid other m = withUser sid other m (sGet m.sess sid).

dismiss m s = clearToast m s.sid s.tn.
flipTheme m s = sPut m { s | theme = 1 - s.theme }.
clearToast m sid n =
  s = sGet m.sess sid;
  if s.tn == n then sPut m { s | toast = "", role = "" } else m.

# ---- profiling -----------------------------------------------------------------------------
# What the app measures about itself, shown on the admin pane (microseconds):
#   update  per kind of event: how long `step` took, i.e. the app's own work
#   append  how long the disk append took, per event that wrote
#   boot    folding the log at start
#   render  per TAB, in its writer: how long `view` took, the card cache's hits
#           and misses and how many cards it keeps (kept in the writer's cache,
#           so it lags the render that shows it by one)
#   memory  the runtime's ledgers (Sys.memInfo, Sys.memStats) and harts
#   rtt     in the browser: from a click's send to the next frame received
# A Stat is a count, a sum, a maximum and the last.
noStat = { n = 0, sum = 0, max = 0, last = 0 }.
note st us = { n = st.n + 1, sum = st.sum + us, max = Int.max st.max us, last = us }.
avg st | st.n == 0 = 0.
avg st = st.sum / st.n.

noProf = { bootUs = 0, bootLines = 0, upd = Nil, flush = noStat, nev = 0 }.
noteUpd kind us prof = { prof | upd = noteKind prof.upd kind us, nev = prof.nev + 1 }.
noteKind es kind us =
  if List.any (fn e -> (k, _) = e; k == kind) es
    then List.map (fn e -> (k, st) = e; if k == kind then (k, note st us) else (k, st)) es
    else List.append es [(kind, note noStat us)].

kindOf (Live.Msg _ msg) = msgKind msg.
kindOf (Live.Joined _) = "join".
kindOf (Live.Left _) = "leave".
kindOf (Live.Refused _ _) = "refused".

msgKind (Login _ _)     = "login".
msgKind Logout          = "logout".
msgKind (ClientState _) = "sync".
msgKind New             = "new".
msgKind (Edit _)        = "edit".
msgKind Save            = "save".
msgKind Cancel          = "cancel".
msgKind (Delete _)      = "delete".
msgKind (AddTag _)      = "tag".
msgKind (AddMember _ _) = "member".
msgKind (Password _)    = "password".
msgKind ForgetDevices   = "forget".
msgKind Theme           = "theme".
msgKind Dismiss         = "dismiss".
msgKind (Clear _ _)     = "toast".
msgKind (Page _)        = "page".
msgKind (Command _)     = "admin".

statLine label st = "{S.padRight 9 " " label} n {S.padLeft 6 " " "{st.n}"}  avg {S.padLeft 7 " " "{avg st}"} us  max {S.padLeft 7 " " "{st.max}"} us  last {st.last} us".

# ---- signing in ---------------------------------------------------------------------------
# at most 8 wrong passwords in five minutes, for the whole house: a guesser
# gains nothing by opening more tabs
login m sid name0 pw =
  name = name0 |> S.trim |> S.toLower;
  now = Clock.now Unit;
  recent = List.filter (fn t -> t > now - 300) m.fails;
  if List.length recent >= 8 then
    refuse { m | fails = recent } sid "too many wrong passwords: try again in a few minutes"
  else if not (checkPw m.members name pw) then
    refuse { m | fails = now :: recent } sid "unknown name or wrong password"
  else
    tok = randomHex Unit;
    m2 = commit m (deviceLine name (Digest.sha256 tok) now);
    s = sGet m2.sess sid;
    (sPut m2 { s | user = name, tried = tok, toast = "", role = "" }, [setLocals sid [G.assign @Client.pw "", G.assign @Client.tok tok]]).

# The mirror: the page's Client, as the server knows it.  A page that is not
# signed in but holds a token is signed in by it, once per token.
mirror m sid c =
  s0 = sGet m.sess sid;
  q = c.q |> S.trim |> S.left 100;
  # a new search or a new order starts at the first page
  page = if q == s0.q and c.sort == s0.sort then s0.page else 0;
  s = { s0 | clientReady = True, q = q, sort = c.sort, page = page, pane = c.pane,
             d = { name = c.name, loc = c.loc, sub = c.sub, desc = c.desc, tags = c.tags } };
  resume m sid s c.tok.

resume m sid s tok | strlen s.user > 0 or strlen tok == 0 or tok == s.tried = (sPut m s, Nil).
resume m sid s tok = case deviceUser m.devices (Digest.sha256 tok) of
    Option.Some name -> (sPut m { s | user = name, tried = tok }, Nil)
  | Option.None -> (sPut m { s | tried = tok }, [setLocals sid [G.assign @Client.tok ""]]).

withUser sid _ m s | s.user == "" = refuse m sid "sign in first".
withUser sid Logout m s = signOut m sid s.
withUser sid New m s = (sPut m { s | editing = 0, d = noDraft }, [setLocals sid (draftLocals noDraft), suggest sid s.user m]).
withUser sid (Page n) m s = (sPut m { s | page = Int.max 0 n }, Nil).
withUser sid (Edit id) m s = edit m sid s id.
withUser sid Cancel m s = (sPut m { s | editing = 0 - 1 }, [setLocals sid (draftLocals noDraft)]).
withUser sid Save m s = save m sid s.
withUser sid (Delete id) m s = delete m sid s id.
withUser sid (AddTag t) m s = addTag m sid s t.
withUser sid (AddMember name pw) m s = addMember m sid s (name, pw).
withUser sid (Password pw) m s = password m sid s pw.
withUser sid ForgetDevices m s = forgetDevices m sid s.
withUser sid (Command cmd) m s = console m sid s cmd.
withUser sid _ m _ = refuse m sid "no such action".

signOut m sid s =
  m2 = if strlen s.tried > 0 then commit m (undeviceLine (Digest.sha256 s.tried) (Clock.now Unit)) else m;
  (sPut m2 { noSess | sid = sid, clientReady = True }, [setLocals sid [G.assign @Client.tok "", G.assign @Client.pane Items]]).

# ---- items ---------------------------------------------------------------------------------

edit m sid s id = case findItem m.items id of
    Option.None -> refuse m sid "that item is gone"
  | Option.Some it ->
      d = { name = it.name, loc = it.loc, sub = it.sub, desc = it.desc, tags = S.join ", " it.tags };
      (sPut m { s | editing = id, d = d }, [setLocals sid (draftLocals d), suggest sid s.user m]).

save m sid s =
  d = s.d;
  name = d.name |> S.trim |> S.left 120;
  loc = d.loc |> S.trim |> S.left 60;
  isNew = s.editing <= 0;
  old = findItem m.items s.editing;
  if strlen name == 0 then refuse m sid "give the item a name"
  else if strlen loc == 0 then refuse m sid "where is it? a room or place is needed"
  else if not isNew and old == Option.None then
    refuse (sPut m { s | editing = 0 - 1 }) sid "that item was deleted while you were editing it"
  else
    now = Clock.now Unit;
    id = if isNew then m.nextId else s.editing;
    created = old |> Option.map (fn o -> o.created) |> Option.withDefault now;
    it = { id = id, name = name, loc = loc, sub = d.sub |> S.trim |> S.left 60, desc = d.desc |> S.trim |> S.left 2000,
           tags = d.tags |> tagsOf |> List.take 12, created = created, at = now, by = s.user, moves = Nil };
    m2 = sPut (commit m (itemLine it s.user now)) { s | editing = 0 - 1, d = noDraft };
    also (say m2 sid (if isNew then "added {name}" else "saved {name}")) [setLocals sid (draftLocals noDraft)].

delete m sid s id = case findItem m.items id of
    Option.None -> refuse m sid "already deleted"
  | Option.Some it ->
      m2 = commit m (delLine id s.user (Clock.now Unit));
      s2 = sGet m2.sess sid;
      m3 = sPut m2 { s2 | editing = if s2.editing == id then 0 - 1 else s2.editing };
      also (say m3 sid "deleted {it.name}") [setLocals sid [G.assign @Client.confirm 0]].

addTag m sid s t =
  have = tagsOf s.d.tags;
  if List.member t have then (m, Nil)
  else
    tags = S.join ", " (have + [t]);
    (sPut m { s | d = { s.d | tags = tags } }, [setLocals sid [G.assign @Client.tags tags]]).

# ---- autocomplete: what the editor's script suggests from ----------------------------------------
# Rooms, spots and tags in the order they were last used, a member's own edits
# counted as a month more recent than they are; the page does the matching.
#   {"loc": [...], "sub": {"*": [...], "<room, lower case>": [...]}, "tags": [...]}
suggest sid user m = Live.Emit sid "suggest" (suggestJson user m.items).

suggestJson user items =
  recent = items |> List.sortBy (Order.reverse Order.int) (fn it -> it.at + (if it.by == user then 2592000 else 0));
  locs = recent |> List.map (fn it -> it.loc) |> uniqueCi |> List.take 100;
  allSubs = recent |> List.map (fn it -> it.sub) |> uniqueCi |> List.take 100;
  spots l = recent
    |> List.filter (fn it -> S.toLower it.loc == S.toLower l)
    |> List.map (fn it -> it.sub)
    |> uniqueCi
    |> List.take 30;
  allTags = recent |> List.concatMap (fn it -> it.tags) |> List.unique |> List.take 100;
  Json.render (Json.object
    [ ("loc", Json.strings locs)
    , ("sub", Json.object (("*", Json.strings allSubs) :: List.map (fn l -> (S.toLower l, Json.strings (spots l))) locs))
    , ("tags", Json.strings allTags) ]).

# the first spelling of each value, ignoring case and the empty one
# (the lower-case spellings seen so far are a linear set, std/mutmap)
uniqueCi xs =
  (out, seen) = List.fold uniqStep (Nil, MutMap.strings Unit) xs;
  _ = MutMap.free seen;
  List.reverse out.

uniqStep (acc, seen) x | strlen x == 0 = (acc, seen).
uniqStep (acc, seen) x =
  k = S.toLower x;
  case MutMap.member k seen of
      (True, s1) -> (acc, s1)
    | (False, s1) -> (x :: acc, MutMap.insert k Unit s1).

# ---- the console: the data, live -------------------------------------------------------------------
# A command and what it answered go on this tab's console (the newest 40
# lines); the input is emptied for the next one.

console m sid s cmd =
  line = S.trim cmd;
  (m2, out) = run m s line;
  s2 = sGet m2.sess sid;
  con = if line == "clear" then Nil else List.take 40 (out :: "> {line}" :: s2.con);
  (sPut m2 { s2 | con = con }, [setLocals sid [G.assign @Client.cmd ""]]).

run m s line = case S.words line of
    Nil -> (m, helpText)
  | w :: _ -> runW m s (S.toLower w) (line |> S.dropLeft (strlen w) |> S.trim).

runW m _ "help" _      = (m, helpText).
runW m _ "clear" _     = (m, "").
runW m _ "stats" _     = (m, statsText m).
runW m _ "find" rest   = (m, findText m rest).
runW m _ "show" rest   = (m, withItem m rest showText).
runW m _ "history" r   = (m, historyText m (idOf r)).
runW m _ "places" _    = (m, m.items |> List.map (fn it -> it.loc) |> ranked |> countsText).
runW m _ "tags" _      = (m, m.items |> List.concatMap (fn it -> it.tags) |> ranked |> countsText).
runW m _ "spots" rest  = (m, spotsText m rest).
runW m s "move" rest   = moveCmd m s (splitArrow rest).
runW m s "rename" rest = renameCmd m s (splitArrow rest).
runW m s "retag" rest  = retagCmd m s (splitArrow rest).
runW m s "delete" rest = deleteCmd m s (idOf rest).
runW m _ "rebuild" _   = rebuildCmd m.
runW m _ w _           = (m, "unknown: {w} (try help)").

helpText = S.join "\n"
  [ "stats                       counts, the log, who is signed in"
  , "find WORDS                  matching items, with their ids"
  , "show ID                     an item, every field"
  , "history ID                  every change to an item, read from the log"
  , "places | tags               each, with how many items have it"
  , "spots PLACE                 the spots in a place"
  , "move ID -> PLACE [/ SPOT]   put an item somewhere else"
  , "rename OLD -> NEW           rename a place on every item in it"
  , "retag ID -> TAGS            replace an item's tags (comma separated)"
  , "delete ID                   delete an item"
  , "rebuild                     fold the log again and compare with the model"
  , "clear                       empty this console" ].

# "#12", "12" -> 12; anything else is 0, which no item has
idOf s =
  t = S.trim s;
  num (if S.startsWith "#" t then t |> S.dropLeft 1 |> S.trim else t).

splitOn sep s = case S.indexOf sep s of
    Option.Some i -> (s |> S.left i |> S.trim, s |> S.dropLeft (i + strlen sep) |> S.trim)
  | Option.None -> (S.trim s, "").

# "a -> b" -> (a, b); no arrow: (s, "")
splitArrow = splitOn "->".
# "room / spot" -> (room, spot)
splitSlash = splitOn "/".

withItem m arg f = case findItem m.items (idOf arg) of
    Option.None -> "no item {S.trim arg} (find WORDS gives ids)"
  | Option.Some it -> f it.

itemRow it = "#{S.padRight 4 " " "{it.id}"} {it.name}  @ {place it}".

plural 1 one _ = "1 {one}".
plural n _ many = "{n} {many}".

statsText m =
  places = m.items |> List.map (fn it -> S.toLower it.loc) |> List.unique |> List.length;
  tags = m.items |> List.concatMap (fn it -> it.tags) |> List.unique |> List.length;
  online = m.sess |> List.map (fn x -> x.user) |> List.filter (fn u -> strlen u > 0) |> S.join ", ";
  S.join "\n"
    [ "{plural (List.length m.items) "item" "items"} in {plural places "place" "places"}, {plural tags "tag" "tags"}"
    , "{plural (List.length m.members) "member" "members"} ({m.members |> List.map memName |> S.join ", "}), {plural (List.length m.devices) "signed-in device" "signed-in devices"}"
    , "signed in now: {online}"
    , "log {m.path}: {m.events} lines ({m.skipped} unreadable), next id {m.nextId}"
    , "up since {Clock.stamp m.booted}" ].

findText _ words | strlen words == 0 = "find WORDS".
findText m words =
  hits = m.items |> List.filter (matches (S.toLower words));
  case hits of
      Nil -> "nothing matches \"{words}\""
    | _ ->
        more = if List.length hits > 25 then ["... and {List.length hits - 25} more"] else Nil;
        hits |> List.take 25 |> List.map itemRow |> (fn rows -> S.join "\n" (rows + more)).

showText it =
  notes = if strlen it.desc == 0 then Nil else ["  notes  " + S.replace "\n" "\n         " it.desc];
  S.join "\n"
    ( "#{it.id} {it.name}"
    :: "  place  {place it}"
    :: "  tags   {S.join ", " it.tags}"
    :: "  added  {Clock.stamp it.created}, updated {Clock.stamp it.at} by {it.by}"
    :: List.map (fn mv -> "  moved from {mv.from} on {Clock.stamp mv.at}") it.moves
    + notes ).

# from the disk, not the model: every line that wrote this item, oldest first
historyText m id = case File.lines m.path of
    Err why -> "cannot read the log: {why}"
  | Ok ls ->
      evs = ls |> List.map parseLine |> List.filter (about id);
      case evs of
          Nil -> "no item #{id} in the log"
        | _ -> evs |> List.drop (Int.max 0 (List.length evs - 30)) |> List.map histLine |> S.join "\n".

# an item or delete line about item `id`
about id (Put it) = it.id == id.
about id (Rename it) = it.id == id.
about id (Del n _ _) = n == id.
about _ _ = False.

histLine (Del _ by at) = "{Clock.stamp at}  {S.padRight 8 " " by} deleted".
histLine (Put it) = itemHist it "".
histLine (Rename it) = itemHist it " (place renamed)".
histLine _ = "".

itemHist it why = "{Clock.stamp it.at}  {S.padRight 8 " " it.by} {it.name} @ {place it}  [{S.join ", " it.tags}]{why}".

countsText Nil = "none yet".
countsText kcs = kcs |> List.map (fn kc -> (k, c) = kc; "{S.padLeft 5 " " "{c}"}  {k}") |> S.join "\n".

spotsText _ p | strlen p == 0 = "spots PLACE".
spotsText m p =
  here = m.items |> List.filter (fn it -> S.toLower it.loc == S.toLower p);
  case here of
      Nil -> "no items in {p}"
    | _ -> here |> List.map (fn it -> if strlen it.sub == 0 then "(no spot)" else it.sub) |> ranked |> countsText.

moveCmd m s (l, r) = case findItem m.items (idOf l) of
    Option.None -> (m, "move ID -> PLACE [/ SPOT]")
  | Option.Some it ->
      (loc, sub) = splitSlash r;
      if strlen loc == 0 then (m, "move ID -> PLACE [/ SPOT]")
      else
        new = { it | loc = S.left 60 loc, sub = S.left 60 sub };
        (commit m (itemLine new s.user (Clock.now Unit)), "#{it.id} {it.name}: {place it} -> {place new}").

renameCmd m _ (old, new) | strlen old == 0 or strlen new == 0 = (m, "rename OLD -> NEW").
renameCmd m s (old, new) =
  hits = m.items |> List.filter (fn it -> S.toLower it.loc == S.toLower old);
  now = Clock.now Unit;
  case hits of
      Nil -> (m, "no items in {old} (places lists them)")
    | _ ->
        m2 = List.fold (fn mm it -> commit mm (renameLine { it | loc = S.left 60 new } s.user now)) m hits;
        (m2, "{old} -> {new} on {plural (List.length hits) "item" "items"}").

retagCmd m s (l, r) = case findItem m.items (idOf l) of
    Option.None -> (m, "retag ID -> TAGS")
  | Option.Some it ->
      new = { it | tags = r |> tagsOf |> List.take 12 };
      (commit m (itemLine new s.user (Clock.now Unit)), "#{it.id} {it.name}: [{S.join ", " new.tags}]").

deleteCmd m s id = case findItem m.items id of
    Option.None -> (m, "delete ID")
  | Option.Some it -> (commit m (delLine id s.user (Clock.now Unit)), "deleted #{id} {it.name}").

# the log wins: fold the disk again and compare every item
rebuildCmd m = case File.lines m.path of
    Err why -> (m, "cannot read the log: {why}")
  | Ok ls ->
      d = ls |> List.filter (fn l -> strlen l > 0) |> replayed initModel;
      wrong = (d.items |> List.filter (fn it -> findItem m.items it.id != Option.Some it) |> List.length)
            + (m.items |> List.filter (fn it -> findItem d.items it.id == Option.None) |> List.length);
      if wrong == 0
        then (m, "the model matches the log: {d.events} lines, {plural (List.length d.items) "item" "items"}")
        else ({ m | items = d.items, nextId = d.nextId }, "rebuilt from the log: {plural wrong "item" "items"} corrected").

# ---- the household ---------------------------------------------------------------------------

addMember m sid _ (name0, pw) =
  name = name0 |> S.trim |> S.toLower;
  if not (wordy name) then refuse m sid "a name is 1 to 16 letters or digits"
  else if hasMember m name then refuse m sid "{name} is already a member"
  else if strlen pw < 8 then refuse m sid "a password is at least 8 characters"
  else
    salt = randomHex Unit;
    m2 = commit m (memberLine name salt (pwHash salt pw) (Clock.now Unit));
    also (say m2 sid "{name} can sign in now") [setLocals sid [G.assign @Client.mname "", G.assign @Client.mpw ""]].

password m sid _ pw | strlen pw < 8 = refuse m sid "a password is at least 8 characters".
password m sid s pw =
  salt = randomHex Unit;
  m2 = commit m (memberLine s.user salt (pwHash salt pw) (Clock.now Unit));
  also (say m2 sid "password changed") [setLocals sid [G.assign @Client.npw ""]].

# every device of this member is forgotten, then this one is remembered again
forgetDevices m sid s =
  now = Clock.now Unit;
  n = m.devices |> List.filter (fn d -> devName d == s.user) |> List.length;
  m2 = commit m (revokeLine s.user now);
  m3 = if strlen s.tried > 0 then commit m2 (deviceLine s.user (Digest.sha256 s.tried) now) else m2;
  say m3 sid "signed out {Int.max 0 (n - 1)} other devices".

# every page mirrors its locals, a third of a second after they change
subs _ = [Live.SyncClientState 300 (ClientState client)].

# ---- what a session sees (Live.serveProjected) -------------------------------------------------
# Its own search, sorted and filtered here; the counts; the chips.  A session
# whose projection did not change renders nothing.

matches q it = q |> S.words |> List.all (fn w -> hit w it).
hit w it = S.contains w (S.toLower it.name) or S.contains w (S.toLower it.loc) or S.contains w (S.toLower it.sub)
        or S.contains w (S.toLower it.desc) or List.any (fn t -> S.contains w t) it.tags.

sorted ByName items  = List.sortBy Order.string (fn it -> S.toLower it.name) items.
sorted ByPlace items = List.sortBy Order.string (fn it -> S.toLower "{place it} {it.name}") items.
sorted Recent items  = List.sortBy (Order.reverse Order.int) (fn it -> it.at) items.

# the most used values first: (value, count).  groupBy groups RUNS of equal
# values, hence the sort first
ranked xs =
  xs
  |> List.sortBy Order.string (fn x -> x)
  |> List.groupBy (fn x -> x)
  |> List.map (fn g -> (k, vs) = g; (k, List.length vs))
  |> List.sortBy (Order.reverse Order.int) (fn kc -> (_, c) = kc; c).

firsts kcs = List.map (fn kc -> (k, _) = kc; k) kcs.

noView = { clientReady = False, signed = 0, user = "", toast = "", role = "", theme = 1, editing = 0 - 1, items = Nil, total = 0, shown = 0,
           page = 0, pages = 1, first = 0, q = "", places = Nil, tags = Nil, quick = Nil, members = Nil, devices = 0, online = 0,
           events = 0, booted = 0, con = Nil, nplaces = 0, ntags = 0, ndevices = 0, skipped = 0, pageSize = 0, keep = 0,
           prof = noProf, mem = Nil, grows = (0, 0), harts = 0 }.

# `size` items a page; a page past the end (the list shrank under it) is the last one.
# The profile and the runtime's numbers change on every event: only a tab on
# the admin pane gets them, so the others do not re-render for them.
project size keep sid m =
  s = sGet m.sess sid;
  if s.user == "" then
    { noView | clientReady = s.clientReady, toast = s.toast, role = s.role, theme = s.theme }
  else
    hits = m.items |> List.filter (matches (S.toLower s.q)) |> sorted s.sort;
    n = List.length hits;
    page = Pagination.plan size n s.page;
    onAdmin = s.pane == Admin;
    places = m.items |> List.map (fn it -> it.loc) |> ranked |> firsts;
    tags = m.items |> List.concatMap (fn it -> it.tags) |> ranked |> firsts;
    { clientReady = True, signed = 1, user = s.user, toast = s.toast, role = s.role, theme = s.theme, editing = s.editing,
      items = hits |> List.drop page.first |> List.take size, total = List.length m.items, shown = n,
      page = page.index, pages = page.pages, first = page.first, q = s.q,
      places = List.take 8 places, tags = List.take 12 tags,
      quick = (tags + quickTags) |> List.unique |> List.take 18,
      members = List.map memName m.members,
      devices = m.devices |> List.filter (fn d -> devName d == s.user) |> List.length,
      online = m.sess |> List.filter (fn x -> strlen x.user > 0) |> List.length,
      events = m.events, booted = m.booted, con = s.con,
      nplaces = List.length places, ntags = List.length tags, ndevices = List.length m.devices, skipped = m.skipped,
      pageSize = size, keep = keep,
      prof = if onAdmin then m.prof else noProf,
      mem = if onAdmin then Sys.memInfo 0 else Nil,
      grows = if onAdmin then Sys.memStats 0 else (0, 0),
      harts = Sys.harts Unit }.

# ---- view ------------------------------------------------------------------------------------------
# Mobile first: one column the width of a phone, capped on a desktop; buttons
# a thumb can hit.  Item cards are remembered per writer (std/view cache): a
# card is a function of its item alone, so it renders once and again only when
# that item changes.

locals = G.locals @Client client.

# the page: its look is the household's day or night (Appearance), the column a
# broad reading one with the client state declared on it; the remembered device
# lives in a hidden input so the page's script can fill it
root v kids =
  light = v.theme == 1;
  UI.pageWith (Appearance.look light) { UI.stack | pad = 3 } [B.feedbackTheme light]
    [UI.vstackWith { UI.stack | gap = 4, fill = UI.Broad } (B.autocompleteScope :: locals + Appearance.tokens light)
      (UI.input { UI.field | kind = UI.HiddenField } [G.bind @Client.tok, B.mark tokenHook ""] :: B.autocompletePrototypes (Appearance.tokens light) :: B.feedbackPrototypes (Appearance.tokens light) :: kids)].

# `keep`: how many cards this tab's writer remembers, this page's and then the
# ones it drew most recently.  The writer's cache also holds its own render
# statistics, which the admin pane shows.
noRender = { st = noStat, hits = 0, misses = 0, kept = 0 }.

view keep _ v old =
  (cardsOld, rs) = old;
  if v.signed == 0 then
    (G.renderStyled (root v (if v.clientReady then [loginView v] else Nil)), old)
  else
    t0 = Sys.timeUs Unit;
    (cards, cc) = G.cacheMany (fn it -> "{it.id}") itemCard v.items (G.cacheBegin "inventory-card-v1" verify cardsOld);
    out = G.renderStyled (root v (signedIn v cards rs));
    kept = G.cacheRetain keep cc;
    (h, mi, _) = G.cacheStats cc;
    (out, (kept, { st = note rs.st (Sys.timeUs Unit - t0), hits = rs.hits + h, misses = rs.misses + mi, kept = G.cacheSize kept })).

verify = Program.envOr "0" "INV_VIEW_VERIFY" == "1".

# the household's buttons: pills a thumb can hit; chips are the small ones
pill = { UI.btn | kind = UI.Pill, size = UI.Body, tall = True }.
chip = { UI.btn | kind = UI.Pill, size = UI.Caption }.
overline = { UI.txt | size = UI.Overline, tone = UI.Muted }.
caption = { UI.txt | size = UI.Caption, tone = UI.Muted }.
btn label attrs = UI.button pill attrs label.
primary label attrs = UI.button { pill | kind = UI.Primary } attrs label.

loginView v =
  UI.card { UI.panel | raised = True, gap = 3, pad = 5 }
    [ UI.label overline "home inventory"
    , UI.label { UI.txt | size = UI.Hero } "Sign in"
    , UI.input { UI.field | placeholder = "name", suggest = "username", caps = False, maxLength = 16 } [G.bind @Client.user]
    , UI.input { UI.field | kind = UI.Password, placeholder = "password", suggest = "current-password" } [G.bind @Client.pw, G.enterWith2 codec Login @Client.user @Client.pw]
    , primary "sign in" [G.sendWith2 codec Login @Client.user @Client.pw]
    , UI.text { caption | tone = UI.Warning } v.toast ].

signedIn v cards rs =
  [ header v
  , UI.toast UI.Success (roleText v "ok")
  , UI.toast UI.Warning (roleText v "warn")
  , itemsPane v cards
  , housePane v
  , adminPane v rs ].

roleText v role | v.role == role = v.toast.
roleText _ _ = "".

# on a phone the title takes its own line and the pane buttons go below it
# a tab: a pill that shows which pane is open (a client local, no server round trip)
tab p label = UI.button { pill | vary = [UI.onState @Client.pane p [UI.Inverted]] } [G.setTo @Client.pane p] label.

header v =
  UI.hstack { UI.stack | gap = 2, align = UI.Center, vary = [UI.OnNarrow [UI.Stacked, UI.AlignOf UI.Start]] }
    [ UI.vstack { UI.stack | fill = UI.Grow }
        [ UI.label overline "home inventory", UI.text { UI.txt | size = UI.Hero, tabular = True } (things v.total) ]
    , UI.hstack { UI.stack | gap = 2, wrap = True } [tab Items "items", tab House "household", tab Admin "admin"] ].

things 1 = "1 thing".
things n = "{n} things".

itemsPane v cards =
  UI.vstackWith { UI.stack | gap = 3 } [G.showIf @Client.pane Items]
    ( UI.hstack { UI.stack | gap = 2, align = UI.Center }
        [ UI.input { UI.field | kind = UI.Search, fill = UI.Grow, placeholder = "search names, places, notes, tags", suggest = "off", caps = False } [G.bind @Client.q, now]
        , primary "+ add" [G.send codec New] ]
    :: UI.hstack { UI.stack | gap = 2, wrap = True, align = UI.Center }
        [ UI.label caption "sort", sortBtn Recent "recent", sortBtn ByName "a-z", sortBtn ByPlace "by place"
        , UI.button chip [G.hideIf @Client.q "", G.setTo @Client.q "", now] "clear search" ]
    :: chipRow (List.map (fn p -> UI.button { chip | vary = [UI.Always [UI.Rigid]] } [G.setTo @Client.q (S.toLower p), now] p) v.places)
    :: chipRow (List.map (fn t -> UI.button { chip | vary = [UI.Always [UI.Rigid]] } [G.setTo @Client.q t, now] "#{t}") v.tags)
    :: (if v.editing == 0 then [editor v] else Nil)
    + [ UI.textWith caption [B.mark listHook ""] (countText v)
      , UI.keyed "items" (UI.vstack { UI.stack | gap = 3 } (if List.isEmpty cards then [empty v] else inPlace v cards))
      , pager v ]).

# the pager, when there is more than one page
pager v | v.pages <= 1 = UI.none Unit.
pager v =
  UI.hstack { UI.stack | gap = 2, align = UI.Center }
    [ pageBtn "previous" (v.page - 1) (v.page == 0)
    , UI.text { caption | align = UI.Center, tabular = True, fill = UI.Grow } "page {v.page + 1} of {v.pages}"
    , pageBtn "next" (v.page + 1) (v.page + 1 >= v.pages) ].

pageBtn label n off = UI.button { pill | vary = if off then [UI.Always [UI.Dimmed]] else Nil } [G.send codec (Page n), B.mark pagerHook ""] label.

# the item being edited is its editor, where its card was
inPlace v cards | v.editing <= 0 = cards.
inPlace v cards = List.zipWith (fn it card -> if it.id == v.editing then G.key "edit-{it.id}" (editor v) else card) v.items cards.

# what changes the search is mirrored at once (std/livejs data-sync-now), not
# on the next tick: the list is what someone is waiting to see
now = G.syncNow.
sortBtn key label = UI.button { chip | vary = [UI.onState @Client.sort key [UI.Inverted]] } [G.setTo @Client.sort key, now] label.

countText v | v.shown == 0 = "".
countText v =
  range = if v.pages <= 1 then "" else "{v.first + 1}-{v.first + List.length v.items} of ";
  if strlen v.q == 0 then (if v.pages <= 1 then "" else "{range}{v.total}")
  else "{range}{v.shown} matching \"{v.q}\"".

empty v | v.total == 0 = UI.card { UI.panel | pad = 5 } [UI.label { caption | size = UI.Body, align = UI.Center } "Nothing here yet. Add the first thing with + add."].
empty _ = UI.card { UI.panel | pad = 5 } [UI.label { caption | size = UI.Body, align = UI.Center } "Nothing matches."].

# a tap on a place or a tag searches for it; a row scrolls sideways on a phone
chipRow kids = UI.hstack { UI.stack | gap = 2, scrollX = True } kids.

editor v =
  UI.card { UI.panel | raised = True, gap = 3 }
      [ UI.label { UI.txt | size = UI.Heading } (if v.editing == 0 then "Add an item" else "Edit item")
      , UI.labelled "name" (UI.input { UI.field | placeholder = "e.g. USB-C cable", maxLength = 120 } [G.bind @Client.name])
      , UI.hstack { UI.stack | gap = 2, vary = [UI.OnNarrow [UI.Stacked]] }
          [ UI.labelled "room or place" (UI.input { UI.field | placeholder = "e.g. study", maxLength = 60, suggest = "off" } [G.bind @Client.loc, B.autocompleteFrom "loc"])
          , UI.labelled "spot" (UI.input { UI.field | placeholder = "e.g. top drawer", maxLength = 60, suggest = "off" } [G.bind @Client.sub, B.autocompleteFrom "sub"]) ]
      , UI.labelled "notes" (UI.input { UI.field | rows = 3, maxLength = 2000 } [G.bind @Client.desc])
      , UI.labelled "tags, comma separated" (UI.input { UI.field | placeholder = "e.g. electronics, cables", caps = False, suggest = "off" } [G.bind @Client.tags, B.autocompleteFrom "tags"])
      , UI.hstack { UI.stack | gap = 2, wrap = True } (List.map (fn t -> UI.button chip [G.send codec (AddTag t)] t) v.quick)
      , UI.hstack { UI.stack | gap = 2 }
          [ UI.button { pill | kind = UI.Primary, vary = [UI.Always [UI.FillOf UI.Grow]] } [G.send codec Save] (if v.editing == 0 then "add item" else "save")
          , btn "cancel" [G.send codec Cancel] ] ].

itemCard : Item -> G.Node .
itemCard it =
  UI.card { UI.panel | gap = 2 }
    ( UI.hstack { UI.stack | gap = 2, align = UI.Center }
        [ UI.label { UI.txt | size = UI.Heading, fill = UI.Grow } it.name
        , UI.button chip [G.send codec (Edit it.id)] "edit"
        , UI.button chip [G.setTo @Client.confirm it.id] "delete" ]
    :: UI.hstack { UI.stack | gap = 2, align = UI.Center, wrap = True } (UI.badge UI.Success it.loc :: (if strlen it.sub == 0 then Nil else [UI.badge UI.Muted it.sub]))
    :: (if strlen it.desc == 0 then Nil else [UI.label { UI.txt | size = UI.Caption, pre = True } it.desc])
    + (if List.isEmpty it.tags then Nil else [UI.hstack { UI.stack | gap = 1, wrap = True } (List.map (fn t -> UI.button chip [G.setTo @Client.q t, now] "#{t}") it.tags)])
    + [ UI.label caption (metaText it)
      , UI.hstackWith { UI.stack | gap = 2, align = UI.Center, wrap = True } [G.showIf @Client.confirm it.id]
          [ UI.label { caption | tone = UI.Warning, fill = UI.Grow } "Delete {it.name}?"
          , UI.button { pill | kind = UI.Destructive } [G.send codec (Delete it.id)] "delete"
          , btn "keep" [G.setTo @Client.confirm 0] ] ]).

metaText it =
  moved = case it.moves of Nil -> "" | mv :: _ -> " · moved from {mv.from} on {Clock.date mv.at}";
  "added {Clock.date it.created} · updated {Clock.date it.at} by {it.by}{moved}".

housePane v =
  UI.vstackWith { UI.stack | gap = 3 } [G.showIf @Client.pane House]
    [ UI.card UI.panel
        [ UI.label { UI.txt | size = UI.Heading } "Signed in as {v.user}"
        , UI.text caption (devicesText v.devices)
        , UI.hstack { UI.stack | gap = 2, wrap = True }
            [ btn "sign out" [G.send codec Logout], btn "sign out my other devices" [G.send codec ForgetDevices]
            , btn "day / night" [G.send codec Theme] ] ]
    , UI.card UI.panel
        [ UI.label { UI.txt | size = UI.Heading } "Change my password"
        , UI.input { UI.field | kind = UI.Password, placeholder = "new password, 8 or more characters", suggest = "new-password" } [G.bind @Client.npw]
        , btn "change password" [G.sendWith codec Password @Client.npw] ]
    , UI.card UI.panel
        [ UI.label { UI.txt | size = UI.Heading } "Members"
        , UI.hstack { UI.stack | gap = 2, wrap = True } (List.map (fn n -> UI.badge UI.Muted n) v.members)
        , UI.hstack { UI.stack | gap = 2, vary = [UI.OnNarrow [UI.Stacked]] }
            [ UI.input { UI.field | placeholder = "name", caps = False, maxLength = 16 } [G.bind @Client.mname]
            , UI.input { UI.field | kind = UI.Password, placeholder = "their password", suggest = "new-password" } [G.bind @Client.mpw] ]
        , btn "add member" [G.sendWith2 codec AddMember @Client.mname @Client.mpw] ]
    , UI.text caption "{v.events} changes in the log · {v.online} signed in now · up since {Clock.stamp v.booted}" ].

# ---- the admin pane: the numbers, the console, the profile ----------------------------------------

adminPane v rs =
  UI.vstackWith { UI.stack | gap = 3 } [G.showIf @Client.pane Admin, B.mark consoleScope ""]
    [ UI.hstack { UI.stack | gap = 2, wrap = True }
        [ watch "items" "{v.total}", watch "places" "{v.nplaces}", watch "tags" "{v.ntags}", watch "members" "{List.length v.members}"
        , watch "devices" "{v.ndevices}", watch "online" "{v.online}", watch "log lines" "{v.events}", watch "since" (Clock.stamp v.booted) ]
    , UI.hstack { UI.stack | gap = 2, align = UI.Center }
        [ UI.input { UI.field | size = UI.Mono, fill = UI.Grow, placeholder = "help | find usb | move 12 -> Room 2 / desk", caps = False, suggest = "off", spell = False }
            [G.bind @Client.cmd, G.enterWith codec Command @Client.cmd, B.mark consoleInput ""]
        , btn "run" [G.sendWith codec Command @Client.cmd, B.mark consoleRun ""] ]
    # a bounded box the console scrolls in: its bounds are the one raw declaration left on this page
    , UI.cardWith { UI.panel | pad = 3 } [B.mark consoleOutput "", UI.console]
        [ UI.text { UI.txt | size = UI.Mono, pre = True } (consoleText v.con) ]
    , UI.label overline "profile"
    , UI.cardWith { UI.panel | pad = 3 } [G.utilities [G.OverflowX G.OverflowAuto]]
        [ UI.text { UI.txt | size = UI.Mono, pre = True } (profileText v rs) ]
    , UI.hstack { UI.stack | gap = 2, align = UI.Center } [ UI.label caption "browser round trip: ", UI.labelWith caption [B.mark rttHook ""] "measuring" ] ].

consoleText Nil = "type help and press enter".
consoleText con = con |> List.reverse |> S.join "\n".

watch label v = UI.card { UI.panel | gap = 0, pad = 2, tile = True } [ UI.label overline label, UI.text { UI.txt | size = UI.Heading, tabular = True } v ].

profileText v rs =
  S.join "\n"
    ( "update, per kind of event ({v.prof.nev} events since boot)"
      :: List.map (fn e -> (k, st) = e; "  {statLine k st}") v.prof.upd
      + ( "disk"
       :: "  {statLine "append" v.prof.flush}"
       :: "  boot: {v.prof.bootLines} lines folded in {v.prof.bootUs} us"
       :: "this tab's writer"
       :: "  {statLine "render" rs.st}"
       :: "  card cache: {rs.hits} hits, {rs.misses} misses; {rs.kept} cards kept of at most {v.keep} ({v.pageSize} a page)"
       :: "runtime"
       :: memLines v.mem v.grows
       + ["  harts {v.harts}, tabs signed in {v.online}"])).

memLines (arena :: free :: reqs :: waits :: direct :: frees :: denied :: inl :: _) (grows, mib) =
  [ "  arena {arena / 1024} MiB reserved, {(arena - free) / 1024} MiB in use, grown {grows} times ({mib} MiB)"
  , "  memory actor: {reqs} requests, {waits} waits, {direct} direct, {inl} inline, {frees} frees, {denied} denied" ].
memLines _ _ = ["  memory: not sampled"].

devicesText 1 = "this is your only signed-in device".
devicesText n = "{n} devices signed in as you".

# The stylesheet is a function of the tree, so it is made from a SAMPLE that
# shows everything -- the editor, a card with every part, both panes, the
# sign-in -- not from the signed-out page the server first sends.
sampleItem = { id = 1, name = "USB-C cable", loc = "study", sub = "top drawer", desc = "two of them", tags = ["cables"],
               created = 0, at = 0, by = "sam", moves = [{ at = 0, from = "garage" }] }.
sampleView = { noView | signed = 1, user = "sam", toast = "sample", role = "ok", editing = 0, items = [sampleItem], total = 41, shown = 41,
               page = 1, pages = 3, first = 20, q = "x", places = ["study"], tags = ["cables"], quick = quickTags, members = ["sam"], devices = 2,
               con = ["> help"] }.
cssAll _ = UI.css (G.El "div" Nil [root sampleView (signedIn sampleView [itemCard sampleItem, empty sampleView] noRender), loginView sampleView]).

# The page's own script: the remembered device.  Once the client has painted,
# the token from localStorage goes into the hidden `tok` input (so it is
# mirrored, and the server signs this page in); afterwards whatever the server
# puts in `tok` -- a new token at sign-in, "" at sign-out or when it no longer
# knows the token -- is what localStorage keeps.
script = rttScript + LJ.src Unit + B.storage "inventory-device" "tok" tokenHook + autocomplete + pagerScript + consoleScript + pendingScript.

# the page's hooks: one value each, placed by the view (`B.mark`) and read by
# the scripts, so a name is written once
consoleScope = B.Attribute "data-console-scope".
consoleInput = B.Attribute "data-console".
consoleRun = B.Attribute "data-console-run".
consoleOutput = B.Attribute "data-console-output".
pagerHook = B.Attribute "data-pager".
listHook = B.Id "inv-list".
tokenHook = B.Attribute "data-device-token".
rttHook = B.Id "inv-rtt".

# The console behaves like a terminal: the newest output is at the bottom and in
# view, and the arrow keys walk back through the commands this browser ran.
consoleScript = B.console {scope = consoleScope, input = consoleInput,
  run = consoleRun, output = consoleOutput,
  storageKey = "inventory-console", limit = 50}.
pagerScript = B.pager (B.Id "lv-root") pagerHook listHook.
# Never frozen.  A button pressed gives way at once.  Anything that waits on
# the server -- a message, a search -- shows a thin bar at the top, pulses the
# button and fades the list if nothing has come back after 100 ms, until the
# next frame does (or 2.5 s, for an
# action that changed nothing the page shows).  A dropped connection (a phone
# waking, a network change) shows "reconnecting" until the client is back:
# std/livejs writes its link state into #lv-link, which lives here, outside
# the live root, so no render replaces it.  Animations are the Web Animations
# API, so the app still has no CSS text.
pendingScript = B.feedback Unit.
# Shared generated monitor, installed before the client opens its socket.
# Observes successful Live sends and accepted frames through explicit events.
rttScript = B.metrics rttHook "".

# The editor's autocomplete, in the page so it answers each keystroke at once.
# An input with data-ac=loc|sub|tags is completed from the lists the server
# sent ('live:suggest'); tags complete the part after the last comma.  The
# box lives outside the live root and clones FP-RISC-owned appearance
# prototypes inside its explicit data-ac-scope. Taking a suggestion fires
# 'input', which is how the client hears the change (and mirrors it).
autocomplete = B.autocomplete Unit.

# ---- the old app's items: a Firestore REST listing ------------------------------------------------
# GET .../documents/inventory?pageSize=1000 saved to a file.  Items already
# here (same name and place) are skipped, so an import can be run again.

importFirestore path store =
  parsed = File.readText path
    |> Result.mapError (fn why -> "inventory: {why}")
    |> Result.andThen (fn text -> Json.parse text |> Result.mapError (fn why -> "inventory: {path}: {why}"));
  case parsed of
      Err why -> Program.fail 1 why
    | Ok v ->
        o = openLog store;
        m = boot o store;
        docs = Json.field "documents" v |> Option.andThen Json.asList |> Option.withDefault Nil;
        its = List.filterMap fsItem docs;
        fresh = notHere m.items its;
        numbered = List.indexedMap (fn i it -> { it | id = m.nextId + i }) fresh;
        _ = case Journal.append (List.map (fn it -> itemLine it "import" it.at) numbered) o.journal of
            Ok _ -> Unit
          | Err why -> Program.fail 1 "inventory: {why}";
        _ = print "[inventory] imported {List.length numbered} items ({List.length its - List.length fresh} already here)";
        0.

# the imported items whose name and place (ignoring case) no item here has: the
# items here go into a linear set of those keys once, then each is one lookup
notHere items its =
  here = List.fold (fn s x -> MutMap.insert (placeKey x) Unit s) (MutMap.strings Unit) items;
  (keep, h2) = List.fold keepNew (Nil, here) its;
  _ = MutMap.free h2;
  List.reverse keep.

keepNew (acc, here) it = case MutMap.member (placeKey it) here of
    (True, h1) -> (acc, h1)
  | (False, h1) -> (it :: acc, h1).

placeKey it =
  n = S.toLower it.name;
  "{strlen n}:{n}{S.toLower (place it)}".

fsStr k doc = Json.at ["fields", k, "stringValue"] doc |> Option.andThen Json.asString |> Option.withDefault "".
fsTime k doc = Json.at ["fields", k, "timestampValue"] doc |> Option.andThen Json.asString |> Option.withDefault "" |> isoSecs.
fsTags doc =
  Json.at ["fields", "tags", "arrayValue", "values"] doc
  |> Option.andThen Json.asList
  |> Option.map (List.filterMap (fn x -> Json.field "stringValue" x |> Option.andThen Json.asString))
  |> Option.withDefault Nil.

fsItem doc =
  name = fsStr "name" doc |> S.trim;
  made = fsTime "createdAt" doc;
  upd = fsTime "updatedAt" doc;
  if strlen name == 0 then Option.None
  else Option.Some {
    id = 0, name = S.left 120 name,
    loc = fsStr "location" doc |> S.trim |> S.left 60,
    sub = fsStr "subLocation" doc |> S.trim |> S.left 60,
    desc = fsStr "description" doc |> S.trim |> S.left 2000,
    tags = doc |> fsTags |> S.join "," |> tagsOf,
    created = made, at = if upd == 0 then made else upd, by = "import", moves = Nil }.

# "2025-06-01T12:34:56.789Z" -> epoch seconds (UTC)
isoSecs s | strlen s < 19 = 0.
isoSecs s = days (num (substr s 0 4)) (num (substr s 5 2)) (num (substr s 8 2)) * 86400
          + num (substr s 11 2) * 3600 + num (substr s 14 2) * 60 + num (substr s 17 2).

days y0 mo d =
  y = if mo <= 2 then y0 - 1 else y0;
  era = y / 400;
  yoe = y - era * 400;
  mp = if mo > 2 then mo - 3 else mo + 9;
  doy = (153 * mp + 2) / 5 + d - 1;
  era * 146097 + yoe * 365 + yoe / 4 - yoe / 100 + doy - 719468.

# ---- a member from the command line ------------------------------------------------------------

addMemberCli store name0 pw =
  name = name0 |> S.trim |> S.toLower;
  o = openLog store;
  m = boot o store;
  if not (wordy name) then Program.fail 2 "inventory: a member's name is 1 to 16 letters or digits"
  else if strlen pw < 8 then Program.fail 2 "inventory: give a password of 8 or more characters (--password or INV_PASSWORD)"
  else
    salt = randomHex Unit;
    _ = case Journal.append [memberLine name salt (pwHash salt pw) (Clock.now Unit)] o.journal of
        Ok _ -> Unit
      | Err why -> Program.fail 1 "inventory: {why}";
    _ = print "[inventory] {name} {if hasMember m name then "has a new password" else "is a member"}";
    0.

# ---- main ---------------------------------------------------------------------------------------------

setting d k v = case Decode.run (Decode.field k d) v of
    Ok x -> x
  | Err why -> Program.fail 2 "inventory: {why}".

serveApp store v =
  port = setting Decode.int "port" v;
  address = setting Decode.string "address" v;
  # Config decoding remains fallible; historical nonpositive values
  # normalize to one before entering the contracted arithmetic core.
  size = Int.max 1 (setting Decode.int "page-size" v);
  # at least a page: the cards on show are always kept
  keep = Int.max size (setting Decode.int "cache-items" v);
  # the inventory is the log, folded at boot; std/live's own store holds
  # nothing of the model, it is there because the driver wants one
  cfg = { address = address, port = port, title = "Home inventory", store = "{store}.kvlog", journal = False,
          script = script, watch = Nil, rebuild = Nil, restart = Nil };
  o = openLog store;
  _ = Live.serveProjectedBody UI.body cfg {
    init = boot o store, update = update o.journal, subs = subs, fields = Nil, codec = codec,
    project = project size keep, same = (fn a b -> a == b),
    view = view keep, cache = (G.cacheEmpty Unit, noRender), css = cssAll };
  0.

main =
  defaults = Json.object [
    ("port", Json.Integer 6720), ("address", Json.Text "127.0.0.1"), ("store", Json.Text "data/inventory.log"),
    ("page-size", Json.Integer 20), ("cache-items", Json.Integer 200),
    ("member", Json.Text ""), ("password", Json.Text ""), ("import", Json.Text "")];
  case Config.load { defaults = defaults, file = Option.None, envPrefix = "INV_", args = Program.args Unit } of
      Err why -> Program.fail 2 "inventory: {why}"
    | Ok v ->
        store = setting Decode.string "store" v;
        member = setting Decode.string "member" v;
        from = setting Decode.string "import" v;
        if strlen member > 0 then addMemberCli store member (setting Decode.string "password" v)
        else if strlen from > 0 then importFirestore from store
        else serveApp store v.
